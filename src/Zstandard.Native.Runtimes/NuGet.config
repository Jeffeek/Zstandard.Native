<?xml version="1.0" encoding="utf-8"?>
<!--
  Used only during the release CI pack job — not during normal development.
  The per-RID packages are packed first and placed in ../../artifacts/nupkg/,
  then this config lets dotnet restore find them before packing the meta-package.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-runtimes" value="../../artifacts/nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-runtimes">
      <package pattern="Zstandard.Native.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
