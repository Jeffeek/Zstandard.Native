<?xml version="1.0" encoding="utf-8"?>
<!--
  Used only during the release CI pack job — not during normal development.
  The per-RID packages are packed first into {repo-root}/artifacts/nupkg/.
  NuGet resolves source paths relative to the config file, so "../../artifacts/nupkg"
  (two levels up from src/Zstandard.Native.Runtimes/) resolves to the repo root's
  artifacts/nupkg/ directory, which is where CI writes all nupkg artifacts.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-runtimes" value="../../artifacts/nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-runtimes">
      <package pattern="Zstandard.Native.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
