<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Zstandard.Native</RootNamespace>
    <AssemblyName>Zstandard.Native</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML on internal-only partial P/Invoke files is noise; we
         document the public API but not every LibraryImport stub. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>


</Project>
