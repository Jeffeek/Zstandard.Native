<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Pin the only allowed feed to nuget.org.
    `clear` purges any inherited machine/user configs that could otherwise
    introduce an attacker-controlled source (dependency confusion).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Package source mapping: every package id resolves through nuget.org and
    nowhere else. New private packages must be added explicitly here.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    Defense in depth: require signed packages from trusted authors / owners.
    Disable this block if you intentionally consume unsigned community packages.
  -->
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>

  <packageSourceCredentials />

  <!--
    Block unsigned/unknown packages from being silently installed.
  -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

</configuration>
